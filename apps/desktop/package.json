{
  "name": "desktop",
  "private": true,
  "version": "0.0.1",
  "description": "gopx-drive desktop app",
  "author": "",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "~5.6.0"
  },
  "build": {
    "appId": "com.gopx.drive",
    "productName": "gopx-drive",
    "directories": { "output": "out" },
    "files": ["main.js", "preload.js", "../web/dist/**"],
    "mac": { "category": "public.app-category.productivity" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
